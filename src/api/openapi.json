{
  "openapi": "3.1.0",
  "info": {
    "title": "Hangry Labs YuE2 music API",
    "version": "1.0.0",
    "description": "Local music generation on one serial FIFO compute worker. /v1/audio/music is a YuE2 extension; /v1/audio/speech provides OpenAI client transport compatibility and generates songs. /mcp exposes restricted agent tools with guide-first generation and one-hour HTTP downloads. Ordinary audio stays 48 kHz stereo. Explicit pcm export is 24 kHz mono signed PCM16LE. Optional Bearer authentication covers /v1 and /mcp; native and Studio routes retain their existing local access policy."
  },
  "servers": [{"url": "/"}],
  "paths": {
    "/mcp": {
      "post": {
        "operationId": "mcpRequest",
        "summary": "Agent music tools over Streamable HTTP JSON-RPC",
        "description": "Tools: skill, generate_song, get_song, cancel_song. Generation requires a retrieved guide token and only accepts lyrics, direction, duration_seconds, tempo_bpm and format. Modern 2026-07-28 and legacy 2025-11-25/2025-06-18. Set Accept to application/json, text/event-stream; modern requests require MCP metadata and matching headers. No inline audio, runtime settings, sessions or SSE stream. See docs/MCP.md.",
        "security": [{"BearerAuth": []}, {}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["jsonrpc", "method"], "properties": {"jsonrpc": {"const": "2.0"}, "id": {"type": ["integer", "string"]}, "method": {"type": "string"}, "params": {"type": "object"}}}}}},
        "responses": {
          "200": {"description": "JSON-RPC response. Tool results include text and structuredContent; failures use isError or JSON-RPC error.", "content": {"application/json": {"schema": {"type": "object"}}}},
          "202": {"description": "Accepted legacy notification, no body"},
          "400": {"description": "Malformed request, invalid metadata or mismatched MCP headers"},
          "401": {"description": "Local Bearer key required"},
          "403": {"description": "Untrusted Host or Origin"},
          "404": {"description": "Unknown modern RPC method"},
          "406": {"description": "Accept must include application/json and text/event-stream"},
          "413": {"description": "RPC body exceeds 128 KiB"},
          "415": {"description": "Content-Type must be application/json"},
          "500": {"description": "Internal protocol failure"}
        }
      },
      "get": {"operationId": "mcpNoEventStream", "summary": "No standalone SSE stream", "responses": {"405": {"description": "Use POST"}}},
      "delete": {"operationId": "mcpNoSession", "summary": "Stateless transport has no session to delete", "responses": {"405": {"description": "Use POST"}}}
    },
    "/skills/songwriting/SKILL.md": {
      "get": {"operationId": "getMusicSkill", "summary": "Read the bundled music skill", "description": "Public reference copy. The MCP skill tool additionally issues the guide token required by generation.", "responses": {"200": {"description": "Markdown skill", "content": {"text/markdown": {"schema": {"type": "string"}}}}}}
    },
    "/artifacts/{token}/song.{format}": {
      "parameters": [
        {"name": "token", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        {"name": "format", "in": "path", "required": true, "schema": {"type": "string", "enum": ["opus", "flac"]}}
      ],
      "get": {"operationId": "downloadAgentSong", "summary": "Download a completed song using its one-hour capability URL", "description": "No Bearer header required; the opaque URL grants access. Expiry is checked per request. Supports byte ranges; no-store. Only the requested export exists.", "responses": {"200": {"description": "48 kHz stereo audio", "content": {"audio/ogg": {"schema": {"type": "string", "format": "binary"}}, "audio/flac": {"schema": {"type": "string", "format": "binary"}}}}, "206": {"description": "Requested byte range"}, "404": {"description": "Missing, invalid or expired capability"}, "416": {"description": "Unsatisfiable byte range"}}},
      "head": {"operationId": "inspectAgentSong", "summary": "Check a live song capability without downloading", "responses": {"200": {"description": "Audio metadata headers"}, "404": {"description": "Missing, invalid or expired capability"}}}
    },
    "/v1/audio/music": {
      "post": {
        "operationId": "createMusic",
        "summary": "Generate one song and return its audio",
        "description": "YuE2 extension. lyrics/input are equivalent; conflicting values fail. instructions supplements style. voice aliases provide approximate vocal direction, not fixed singer identities. Duration limits generation before optional speed adjustment. Native settings, including explicit score/replay conditioning, are accepted. Use /synth for asynchronous jobs or batches.",
        "security": [{"BearerAuth": []}, {}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MusicRequest"}}}},
        "responses": {
          "200": {"$ref": "#/components/responses/Audio"},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "409": {"$ref": "#/components/responses/Error"},
          "429": {"$ref": "#/components/responses/Busy"},
          "507": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"},
          "504": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/audio/speech": {
      "post": {
        "operationId": "createSpeech",
        "summary": "Generate music through an OpenAI-compatible audio request",
        "description": "Uses the same music implementation and serial queue as /v1/audio/music. input is lyrics and instructions is musical direction. This endpoint returns music, not spoken narration. Binary audio delivery is supported; live generation and speech SSE events are unavailable.",
        "security": [{"BearerAuth": []}, {}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MusicRequest"}}}},
        "responses": {
          "200": {"$ref": "#/components/responses/Audio"},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "409": {"$ref": "#/components/responses/Error"},
          "429": {"$ref": "#/components/responses/Busy"},
          "507": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"},
          "504": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/models": {"get": {
      "operationId": "listModels", "summary": "Discover the local music model",
      "security": [{"BearerAuth": []}, {}],
      "responses": {"200": {"description": "OpenAI-shaped model list", "content": {"application/json": {"schema": {
        "type": "object", "required": ["object", "data"], "properties": {
          "object": {"const": "list"}, "data": {"type": "array", "items": {"$ref": "#/components/schemas/Model"}}
        }
      }}}}, "401": {"$ref": "#/components/responses/Error"}}
    }},
    "/v1/models/{id}": {"get": {
      "operationId": "retrieveModel", "summary": "Resolve YuE2 or a compatibility alias",
      "security": [{"BearerAuth": []}, {}],
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
      "responses": {"200": {"description": "Canonical YuE2 model metadata", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Model"}}}}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}
    }},
    "/synth": {"post": {
      "operationId": "submitNativeMusic", "summary": "Submit a native asynchronous generation job",
      "description": "Retains native batching, replay metadata, scores and latents. GPU jobs remain serial.",
      "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NativeRequest"}}}},
      "responses": {"200": {"$ref": "#/components/responses/Job"}, "429": {"$ref": "#/components/responses/NativeBusy"}, "507": {"description": "Result volume is full"}, "413": {"description": "Payload exceeds 64 MiB"}, "400": {"description": "Native error object with an error string"}}
    }},
    "/job": {
      "get": {
        "operationId": "getJob", "summary": "Poll a job or download its completed result",
        "parameters": [
          {"name": "id", "in": "query", "required": true, "schema": {"type": "string"}},
          {"name": "result", "in": "query", "description": "Presence requests the result instead of status", "schema": {"type": "integer", "enum": [1]}}
        ],
        "responses": {"200": {"description": "Status JSON, or result: native synthesis multipart audio/replay/latents; VAE or compatibility jobs return raw audio/latents; transcription/tokenization return JSON", "content": {"application/json": {"schema": {"type": "object"}}, "multipart/mixed": {"schema": {"type": "string", "format": "binary"}}, "application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}}, "206": {"description": "Partial result bytes"}, "429": {"$ref": "#/components/responses/NativeBusy"}, "416": {"description": "Unsatisfiable byte range"}, "404": {"description": "Job/result unavailable or expired"}}
      },
      "post": {
        "operationId": "cancelJob", "summary": "Request cooperative cancellation",
        "parameters": [
          {"name": "id", "in": "query", "required": true, "schema": {"type": "string"}},
          {"name": "cancel", "in": "query", "required": true, "schema": {"type": "integer", "enum": [1]}}
        ],
        "responses": {"200": {"description": "Current status; cancellation completes cooperatively"}, "404": {"description": "Unknown job"}}
      }
    },
    "/vae": {"post": {
      "operationId": "submitVae", "summary": "Encode uploaded audio or decode raw latents",
      "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {
        "type": "object", "properties": {
          "audio": {"type": "string", "format": "binary"}, "src_latents": {"type": "string", "format": "binary", "description": "Time-major f32 [T,64]"},
          "request": {"type": "string", "format": "binary", "description": "Optional native request JSON file controlling output"}
        }, "oneOf": [{"required": ["audio"], "not": {"required": ["src_latents"]}}, {"required": ["src_latents"], "not": {"required": ["audio"]}}]
      }}}}, "responses": {"200": {"$ref": "#/components/responses/Job"}, "429": {"$ref": "#/components/responses/NativeBusy"}, "507": {"description": "Result volume is full"}, "413": {"description": "Payload exceeds 64 MiB"}, "400": {"description": "Invalid upload"}}
    }},
    "/transcribe": {"post": {
      "operationId": "submitScoreTranscription", "summary": "Optional music-to-ABC transcription; not lyric ASR",
      "description": "Route exists only when the optional transcriber is configured; inspect /props capabilities.",
      "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"type": "object", "required": ["audio"], "properties": {"audio": {"type": "string", "format": "binary"}, "melody_only": {"type": "string", "description": "Presence requests melody-only ABC"}}}}}},
      "responses": {"200": {"$ref": "#/components/responses/Job"}, "429": {"$ref": "#/components/responses/NativeBusy"}, "507": {"description": "Result volume is full"}, "413": {"description": "Payload exceeds 64 MiB"}, "400": {"description": "Invalid upload"}, "404": {"description": "Optional model unavailable"}}
    }},
    "/tokenize": {"post": {
      "operationId": "submitTokenization", "summary": "Optional audio-to-semantic-token encoding",
      "description": "Route exists only when the optional tokenizer is configured; inspect /props capabilities.",
      "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"type": "object", "required": ["audio"], "properties": {"audio": {"type": "string", "format": "binary"}}}}}},
      "responses": {"200": {"$ref": "#/components/responses/Job"}, "429": {"$ref": "#/components/responses/NativeBusy"}, "507": {"description": "Result volume is full"}, "413": {"description": "Payload exceeds 64 MiB"}, "400": {"description": "Invalid upload"}, "404": {"description": "Optional model unavailable"}}
    }},
    "/health": {"get": {"operationId": "health", "summary": "Liveness, queue capacity and volume usage; remains healthy when saturated", "responses": {"200": {"$ref": "#/components/responses/RuntimeStatus"}}}},
    "/status": {"get": {"operationId": "runtimeStatus", "summary": "Aggregate runtime status without prompts or job handles", "responses": {"200": {"$ref": "#/components/responses/RuntimeStatus"}}}},
    "/system/queue": {"get": {"operationId": "queueStatus", "summary": "Shared queue counts, limits, rejections and result volume usage", "responses": {"200": {"$ref": "#/components/responses/RuntimeStatus"}}}},
    "/props": {"get": {"operationId": "properties", "summary": "Defaults, models, capabilities and output formats", "responses": {"200": {"description": "Native service configuration"}}}},
    "/system/gpu": {"get": {"operationId": "gpuTelemetry", "summary": "On-request device telemetry and bounded history", "responses": {"200": {"description": "GPU telemetry or unavailability details"}}}},
    "/logs": {"get": {"operationId": "logs", "summary": "Global native stderr stream", "responses": {"200": {"description": "Server-sent log events", "content": {"text/event-stream": {"schema": {"type": "string"}}}}}}},
    "/docs": {"get": {"operationId": "apiGuide", "summary": "Local browser API guide", "responses": {"200": {"description": "Embedded UI opened on its API view; gzip supported by browsers", "content": {"text/html": {"schema": {"type": "string"}}}}}}},
    "/openapi.json": {"get": {"operationId": "apiSchema", "summary": "This OpenAPI document", "responses": {"200": {"description": "OpenAPI 3.1", "content": {"application/json": {"schema": {"type": "object"}}}}}}}
  },
  "components": {
    "securitySchemes": {"BearerAuth": {"type": "http", "scheme": "bearer", "description": "Required on /v1 and /mcp when YUE2_API_KEY is configured. This is a local key, not an OpenAI account credential."}},
    "schemas": {
      "NativeRequest": {
        "type": "object", "additionalProperties": true,
        "properties": {
          "style": {"type": "string"}, "lyrics": {"type": "string"}, "cot": {"type": "string", "enum": ["full", "melody", "off"], "default": "full"},
          "abc": {"type": "string", "description": "Explicit score conditioning; fresh generation leaves this empty"},
          "semantic_tokens": {"type": "string"}, "source_tokens": {"type": "string"}, "source_start": {"type": "number"}, "source_end": {"type": "number"},
          "duration": {"type": "number", "minimum": 0, "default": 360}, "steps": {"type": "integer", "minimum": 1, "default": 8},
          "seed": {"type": "integer", "format": "int64", "default": -1}, "lm_seed": {"type": "integer", "format": "int64", "default": -1},
          "lm_batch_size": {"type": "integer", "minimum": 1, "default": 1}, "synth_batch_size": {"type": "integer", "minimum": 1, "maximum": 3, "default": 2, "description": "Acoustic renditions per composition. Fresh requests default to two; legacy replay requests with semantic_tokens and no count retain one."},
          "cfg_scale": {"type": "number"}, "peak_clip": {"type": "integer", "default": 10}, "mp3_bitrate": {"type": "integer", "default": 128},
          "output_format": {"type": "string", "description": "Native audio format. The v1 adapters also accept wav and pcm aliases.", "default": "mp3"},
          "abc_sampling": {"$ref": "#/components/schemas/Sampling"}, "semantic_sampling": {"$ref": "#/components/schemas/Sampling"},
          "plan_retries": {"type": "integer", "minimum": 0, "maximum": 8, "default": 2, "description": "Extra planning attempts for structurally malformed model-generated ABC, before semantic/audio generation. Zero disables retries, not the check. Supplied scores and replays are unchanged; greedy planning is not retried. This does not validate musical quality, lyrics or a complete ending."},
          "adapters": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "scale": {"type": "number", "default": 1}}}}
        }
      },
      "Sampling": {"type": "object", "properties": {
        "temperature": {"type": "number"}, "top_p": {"type": "number"}, "top_k": {"type": "integer"}, "repetition_penalty": {"type": "number"},
        "penalty_window": {"type": "integer"}, "min_tokens": {"type": "integer"}, "max_tokens": {"type": "integer"}
      }},
      "MusicRequest": {
        "allOf": [
          {"$ref": "#/components/schemas/NativeRequest"},
          {"type": "object", "anyOf": [{"required": ["input"]}, {"required": ["lyrics"]}, {"required": ["style"]}, {"required": ["instructions"]}], "properties": {
            "model": {"type": ["string", "null"], "enum": ["yue2", "yue2-3b", "tts-1", "tts-1-hd", "gpt-4o-mini-tts", null], "default": "yue2"},
            "input": {"type": ["string", "null"], "description": "Lyrics verbatim. An empty string plus instrumental direction is supported."},
            "instructions": {"type": ["string", "null"], "description": "Additional genre, instrumentation, mood and delivery direction"},
            "voice": {"type": ["string", "null"], "enum": ["auto", "default", "female", "male", "alloy", "ash", "ballad", "coral", "echo", "fable", "nova", "onyx", "sage", "shimmer", "verse", "marin", "cedar", null], "default": "auto", "description": "Approximate vocal-style hint, not an OpenAI voice or a fixed YuE2 singer identity"},
            "response_format": {"type": ["string", "null"], "enum": ["mp3", "opus", "aac", "flac", "wav", "pcm", "ogg", "m4a", "wav16", "wav24", "wav32", null], "default": "mp3"},
            "speed": {"type": ["number", "null"], "minimum": 0.25, "maximum": 4, "default": 1, "description": "Pitch-preserving output tempo adjustment; not inference speed or prompt BPM"},
            "stream_format": {"type": ["string", "null"], "enum": ["audio", null], "default": "audio"},
            "stream": {"type": ["boolean", "null"], "enum": [false, null]}, "n": {"type": ["integer", "null"], "enum": [1, null]},
            "lm_batch_size": {"const": 1}, "synth_batch_size": {"const": 1, "default": 1}
          }}
        ]
      },
      "Model": {"type": "object", "required": ["id", "object", "created", "owned_by"], "properties": {
        "id": {"const": "yue2"}, "object": {"const": "model"}, "created": {"type": "integer"}, "owned_by": {"type": "string"},
        "aliases": {"type": "array", "items": {"type": "string"}}, "capabilities": {"type": "object"}
      }},
      "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "object", "required": ["message", "type", "param", "code"], "properties": {
        "message": {"type": "string"}, "type": {"type": "string"}, "param": {"type": ["string", "null"]}, "code": {"type": "string"}
      }}}}
    },
    "responses": {
      "RuntimeStatus": {"description": "Uncached liveness plus queue, result-storage and HTTP limits. See docs/QUEUE.md. Queue saturation does not change HTTP 200.", "content": {"application/json": {"schema": {"type": "object", "required": ["status", "queue", "results", "http"], "properties": {
        "status": {"const": "ok"},
        "queue": {"type": "object", "required": ["limit", "pending", "active", "queued", "available", "accepting"], "properties": {
          "limit": {"type": "integer", "minimum": 1}, "pending": {"type": "integer", "minimum": 0}, "active": {"type": "integer", "minimum": 0, "maximum": 1},
          "queued": {"type": "integer", "minimum": 0}, "available": {"type": "integer", "minimum": 0}, "accepting": {"type": "boolean"},
          "retry_after_seconds": {"type": "integer"}, "rejected": {"type": "integer"}, "completed": {"type": "integer"}, "failed": {"type": "integer"}, "cancelled": {"type": "integer"}, "active_operation": {"type": "string"}
        }}, "results": {"type": "object", "description": "Disk-backed native results: counts, bytes, limits, ttl_seconds and full; no file paths or content"},
        "http": {"type": "object", "description": "Fixed HTTP worker, waiter, download, log stream and upload limits"}
      }}}}},
      "Busy": {"description": "Submission refused before job creation. Wait, then retry with backoff and jitter.", "headers": {"Retry-After": {"schema": {"type": "integer", "const": 5}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "NativeBusy": {"description": "Queue or bounded transfer/upload slots are full. No new job was accepted.", "headers": {"Retry-After": {"schema": {"type": "integer", "const": 5}}}},
      "Audio": {"description": "Complete audio file. Normal exports remain 48 kHz stereo; explicit pcm is raw 24 kHz mono PCM16LE. No multipart envelope.",
        "headers": {
          "X-Request-ID": {"schema": {"type": "string"}}, "X-YuE2-Job-ID": {"schema": {"type": "string"}, "description": "Native job ID for inspection/cancellation"},
          "X-Audio-Sample-Rate": {"schema": {"type": "integer"}}, "X-Audio-Channels": {"schema": {"type": "integer"}}
        },
        "content": {
          "audio/mpeg": {"schema": {"type": "string", "format": "binary"}}, "audio/ogg": {"schema": {"type": "string", "format": "binary"}},
          "audio/aac": {"schema": {"type": "string", "format": "binary"}}, "audio/flac": {"schema": {"type": "string", "format": "binary"}},
          "audio/mp4": {"schema": {"type": "string", "format": "binary"}}, "audio/wav": {"schema": {"type": "string", "format": "binary"}},
          "audio/pcm": {"schema": {"type": "string", "format": "binary"}}
        }
      },
      "Error": {"description": "OpenAI-shaped error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Job": {"description": "Submitted native job", "content": {"application/json": {"schema": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}}}}}
    }
  }
}
