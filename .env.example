# Optional local Task configuration. Copy to .env; CLI Task variables override it.
YUE2_IMAGE=yue2:dev
YUE2_CONTAINER=yue2-dev
YUE2_PORT=8087
YUE2_BIND_ADDRESS=127.0.0.1
YUE2_GPU_DEVICE=all
YUE2_CUDA_ARCHITECTURES=auto
YUE2_BUILD_JOBS=4
# Optional local GGML artifact override; normally selected automatically.
YUE2_GGML_DEPS_IMAGE=
# Optional remote ASR judge for manual benchmarks (no local ASR model is loaded).
YUE2_ASR_URL=
# Optional Bearer key for /v1 and /mcp routes. Empty keeps local keyless access.
YUE2_API_KEY=
# Synchronous audio deadline, including queue time; native /synth stays asynchronous.
YUE2_API_TIMEOUT_SECONDS=600
# Origin reachable by MCP clients; no path. Default http://localhost:8087.
YUE2_MCP_PUBLIC_URL=
# Optional export-directory override; Docker defaults to /output/agent-artifacts.
YUE2_MCP_OUTPUT_DIR=
# Maximum accepted compute jobs, including the active song (one GPU worker).
YUE2_QUEUE_LIMIT=8
# Native/Studio/API results: Docker defaults to /output/jobs on the output volume.
YUE2_RESULT_DIR=
# Completed results survive restarts for 24 hours. Live results are not evicted early.
YUE2_RESULT_TTL_SECONDS=86400
YUE2_RESULT_MAX_BYTES=10737418240
YUE2_RESULT_MAX_FILES=256
