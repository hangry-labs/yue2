# Small native dependencies: immutable upstream archives, cached by CMake/Docker.
include_guard(GLOBAL)
include(FetchContent)
if(POLICY CMP0135)
    cmake_policy(SET CMP0135 NEW)
endif()

function(yue2_fetch_app_dependency name output)
    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../docker/app-deps.json" lock)
    string(JSON url GET "${lock}" packages "${name}" url)
    string(JSON checksum GET "${lock}" packages "${name}" sha256)
    FetchContent_Declare(yue2_${name} URL "${url}" URL_HASH "SHA256=${checksum}")
    FetchContent_GetProperties(yue2_${name} POPULATED populated SOURCE_DIR source)
    if(NOT populated)
        FetchContent_Populate(yue2_${name})
        FetchContent_GetProperties(yue2_${name} SOURCE_DIR source)
    endif()
    set(${output} "${source}" PARENT_SCOPE)
endfunction()

set(YUE2_APP_DEPS_PREFIX "" CACHE PATH "Precompiled small native dependencies")
if(YUE2_APP_DEPS_PREFIX)
    file(READ "${CMAKE_CURRENT_LIST_DIR}/../docker/app-deps.json" expected)
    file(READ "${YUE2_APP_DEPS_PREFIX}/share/yue2-app-deps/app-deps.json" installed)
    string(REPLACE "\r\n" "\n" expected "${expected}")
    string(REPLACE "\r\n" "\n" installed "${installed}")
    if(NOT expected STREQUAL installed)
        message(FATAL_ERROR "Native dependency installation does not match app-deps.json")
    endif()
    find_package(httplib CONFIG REQUIRED PATHS "${YUE2_APP_DEPS_PREFIX}/lib/cmake/httplib" NO_DEFAULT_PATH)
    if(NOT TARGET httplib)
        add_library(httplib ALIAS httplib::httplib)
    endif()
    find_package(yyjson CONFIG REQUIRED PATHS "${YUE2_APP_DEPS_PREFIX}/lib/cmake/yyjson" NO_DEFAULT_PATH)
    if(NOT TARGET yyjson)
        add_library(yyjson ALIAS yyjson::yyjson)
    endif()
    set(minimp3_include "${YUE2_APP_DEPS_PREFIX}/include")
    message(STATUS "Using prebuilt native dependencies: ${YUE2_APP_DEPS_PREFIX}")
else()
    set(HTTPLIB_COMPILE ON CACHE BOOL "" FORCE)
    set(HTTPLIB_TEST OFF CACHE BOOL "" FORCE)
    foreach(feature OPENSSL WOLFSSL MBEDTLS ZLIB BROTLI ZSTD)
        set(HTTPLIB_USE_${feature}_IF_AVAILABLE OFF CACHE BOOL "" FORCE)
    endforeach()
    set(YYJSON_BUILD_TESTS OFF CACHE BOOL "" FORCE)
    set(YYJSON_BUILD_MISC OFF CACHE BOOL "" FORCE)
    yue2_fetch_app_dependency(httplib YUE2_HTTPLIB_SOURCE)
    yue2_fetch_app_dependency(yyjson YUE2_YYJSON_SOURCE)
    yue2_fetch_app_dependency(minimp3 YUE2_MINIMP3_SOURCE)
    add_subdirectory("${YUE2_HTTPLIB_SOURCE}" "${CMAKE_BINARY_DIR}/httplib")
    add_subdirectory("${YUE2_YYJSON_SOURCE}" "${CMAKE_BINARY_DIR}/yyjson")
    set(minimp3_include "${YUE2_MINIMP3_SOURCE}")
endif()
add_library(minimp3 INTERFACE)
target_include_directories(minimp3 SYSTEM INTERFACE "${minimp3_include}")
