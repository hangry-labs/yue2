# Apply only reviewed patches to the checksum-pinned official source. Whole-file
# hashes make reconfiguration idempotent and reject a different source revision.
function(yue2_patch_ggml source)
    set(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    file(READ "${root}/docker/ggml-source.json" lock)
    string(JSON count ERROR_VARIABLE no_patches LENGTH "${lock}" patches)
    if(no_patches OR count EQUAL 0)
        return()
    endif()
    find_package(Git REQUIRED)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        foreach(field file sha256 target before_sha256 after_sha256)
            string(JSON ${field} GET "${lock}" patches ${index} ${field})
        endforeach()
        file(SHA256 "${root}/${file}" actual_patch)
        if(NOT actual_patch STREQUAL sha256)
            message(FATAL_ERROR "GGML patch checksum mismatch: ${file}")
        endif()
        file(SHA256 "${source}/${target}" actual_source)
        if(actual_source STREQUAL after_sha256)
            continue()
        endif()
        if(NOT actual_source STREQUAL before_sha256)
            message(FATAL_ERROR "GGML patch preimage mismatch: ${target}")
        endif()
        # A fetched tree may live inside the application's Git working tree.
        # Do not let git apply discover that parent and interpret paths there.
        get_filename_component(ceiling "${source}" DIRECTORY)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env "GIT_CEILING_DIRECTORIES=${ceiling}"
            "${GIT_EXECUTABLE}" apply "${root}/${file}"
            WORKING_DIRECTORY "${source}" RESULT_VARIABLE result ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "GGML patch failed: ${error}")
        endif()
        file(SHA256 "${source}/${target}" actual_source)
        if(NOT actual_source STREQUAL after_sha256)
            message(FATAL_ERROR "GGML patched source checksum mismatch: ${target}")
        endif()
        message(STATUS "Applied reviewed GGML patch: ${file}")
    endforeach()
endfunction()
